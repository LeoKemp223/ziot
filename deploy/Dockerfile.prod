# syntax=docker/dockerfile:1
# 生产镜像：一次构建，web / worker / 迁移种子共用（compose 里用不同 command 区分）。
# 国内源：apk 走腾讯镜像，corepack/pnpm 与 npm 依赖走 npmmirror。

FROM node:20-alpine AS base
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.tencent.com/g' /etc/apk/repositories
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com \
    npm_config_registry=https://registry.npmmirror.com
RUN corepack enable

# ① 只装依赖（按 lockfile 冻结），利用层缓存
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/config/package.json packages/config/
COPY packages/db/package.json packages/db/
COPY packages/domain/package.json packages/domain/
COPY packages/device-simulator/package.json packages/device-simulator/
RUN pnpm install --frozen-lockfile

# ② 拷源码、生成 Prisma Client、构建 Next.js
FROM deps AS build
WORKDIR /app
COPY . .
RUN pnpm --filter @ziot/db prisma:generate \
  && pnpm --filter @ziot/web build

# 差分固件工具：detools（bsdiff+heatshrink 补丁生成，sdist 需编译 C 扩展）。
# venv 路径两阶段一致，拷到 runtime 后 shebang 依然有效。
RUN apk add --no-cache python3 py3-pip python3-dev build-base \
  && python3 -m venv /opt/detools \
  && /opt/detools/bin/pip install --no-cache-dir detools

# ③ 运行时：沿用完整工作区（web 需要 .next + node_modules，worker/seed 需要 tsx + prisma CLI）
FROM base AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
RUN apk add --no-cache python3
COPY --from=build /app .
COPY --from=build /opt/detools /opt/detools
ENV DETOOLS_BIN=/opt/detools/bin/detools
EXPOSE 3000
CMD ["pnpm", "--filter", "@ziot/web", "start"]
